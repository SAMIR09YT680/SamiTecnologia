---
import SeoHead from '../components/SeoHead.astro';
// SamiTecnologia — Inicio v2 · Astro + TypeScript
// La página principal se mantiene estática para cargar rápido.
// React se utiliza para las herramientas interactivas.

const categorias = [
  {
    numero: '01',
    icono: '</>',
    nombre: 'Programación',
    descripcion: 'Del primer código a tus propias aplicaciones. Aprende desarrollo web con ejemplos reales.',
    etiqueta: 'Desarrollo y software',
    destino: '/programacion/',
    clase: 'programacion',
  },
  {
    numero: '02',
    icono: '⌘',
    nombre: 'Redes y sistemas',
    descripcion: 'Comprende cómo se conectan los dispositivos y aprende a configurar tus propias redes.',
    etiqueta: 'Infraestructura y conexión',
    destino: '/redes/',
    clase: 'redes',
  },
  {
    numero: '03',
    icono: '{ }',
    nombre: 'Herramientas',
    descripcion: 'Utilidades sencillas, rápidas y gratuitas para resolver necesidades digitales.',
    etiqueta: 'Productividad y utilidades',
    destino: '/herramientas/',
    clase: 'herramientas',
  },
  {
    numero: '04',
    icono: '↗',
    nombre: 'Tutoriales',
    descripcion: 'Explicaciones claras y guías paso a paso para llevar tus ideas a la práctica.',
    etiqueta: 'Aprendizaje práctico',
    destino: '/tutoriales/',
    clase: 'tutoriales',
  },
];

const proximosArticulos = [
  {
    categoria: 'REDES',
    titulo: 'Qué es una dirección IP y cómo funciona',
    descripcion: 'Aprende IPv4, máscaras, redes privadas y nociones de conectividad.',
    icono: '01',
    tono: 'blue',
    enlace: '/redes/direcciones-ip/',
    estado: 'Leer guía',
  },
  {
    categoria: 'PROGRAMACIÓN',
    titulo: 'Primeros pasos con JavaScript',
    descripcion: 'Variables, funciones y eventos para empezar a programar.',
    icono: '</>',
    tono: 'violet',
    enlace: '/programacion/primeros-pasos-javascript/',
    estado: 'Leer guía',
  },
  {
    categoria: 'TUTORIALES',
    titulo: 'Diseño responsive con Flexbox y Grid',
    descripcion: 'Crea páginas que se adapten a móviles y computadores.',
    icono: '↗',
    tono: 'mint',
    enlace: '/programacion/diseno-responsive/',
    estado: 'Leer guía',
  },
];

const proximasHerramientas = [
  { icono: 'IP', nombre: 'Calculadora IPv4/CIDR', descripcion: 'Subred, máscara, hosts y broadcast.', clase: 'blue', disponible: true, destino: '/herramientas/calculadora-ip/' },
  { icono: 'QR', nombre: 'Generador de códigos QR', descripcion: 'Crea y descarga QR en PNG o SVG.', clase: 'cyan', disponible: true, destino: '/herramientas/generador-qr/' },
  { icono: '01', nombre: 'Conversor de bases', descripcion: 'Binario, decimal y hexadecimal.', clase: 'violet', disponible: true, destino: '/herramientas/conversor-bases/' },
  { icono: '{ }', nombre: 'Formateador JSON', descripcion: 'Da formato y valida estructuras JSON.', clase: 'mint', disponible: true, destino: '/herramientas/formateador-json/' },
  { icono: '•••', nombre: 'Generador de contraseñas', descripcion: 'Claves aleatorias seguras y configurables.', clase: 'blue', disponible: true, destino: '/herramientas/generador-contrasenas/' },
  { icono: 'Aa', nombre: 'Contador de palabras', descripcion: 'Analiza palabras, caracteres y tiempo de lectura.', clase: 'cyan', disponible: true, destino: '/herramientas/contador-palabras/' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09172B" />
    <SeoHead
      title="SamiTecnologia | Explora · Aprende · Innova"
      description="Aprende programación, redes y tecnología con tutoriales claros y seis herramientas digitales gratuitas en SamiTecnologia."
    />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header" id="inicio">
      <div class="nav-shell container">
        <a class="brand" href="#inicio" aria-label="SamiTecnologia, ir al inicio">
          <img src="/images/logo-horizontal.webp" alt="SamiTecnologia" width="946" height="353" fetchpriority="high" />
        </a>

        <nav class="desktop-nav" aria-label="Navegación principal">
          <a class="nav-active" href="#inicio">Inicio</a>
          <a href="#categorias">Explorar</a>
          <a href="#contenidos">Contenidos</a>
          <a href="/herramientas/">Herramientas</a>
          <a href="#acerca">Nosotros</a>
        </nav>

        <div class="header-actions">
          <button type="button" class="search-button" data-open-search aria-label="Buscar contenido" title="Buscar contenido">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 4.5 4.5"/></svg>
            <span>Buscar</span>
            <kbd>Ctrl K</kbd>
          </button>
          <button type="button" class="menu-button" data-menu-toggle aria-controls="mobile-navigation" aria-expanded="false" aria-label="Abrir menú">
            <svg class="menu-icon" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <nav id="mobile-navigation" class="mobile-nav" aria-label="Navegación móvil" hidden>
        <a href="#inicio">Inicio</a>
        <a href="#categorias">Explorar</a>
        <a href="#contenidos">Contenidos</a>
        <a href="/herramientas/">Herramientas</a>
        <a href="#acerca">Nosotros</a>
      </nav>
    </header>

    <main id="contenido">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
        <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
        <div class="container hero-layout">
          <div class="hero-copy">
            <div class="eyebrow"><span class="eyebrow-dot"></span> EXPLORA · APRENDE · INNOVA</div>
            <h1 id="hero-title">La tecnología al alcance <span>de tus ideas<span class="period">.</span></span></h1>
            <p class="hero-description">El espacio donde el conocimiento se convierte en posibilidades. Aprende programación, comprende las redes y descubre recursos para crear algo extraordinario.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="/herramientas/">Explorar herramientas <span aria-hidden="true">↗</span></a>
              <a class="button button-ghost" href="#categorias">Descubrir contenido <span aria-hidden="true">→</span></a>
            </div>
            <div class="hero-highlights" aria-label="Lo que encontrarás">
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg> Tutoriales prácticos</span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg> Herramientas gratuitas</span>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="hero-art-halo"></div>
            <div class="hero-art-ring ring-one"></div>
            <div class="hero-art-ring ring-two"></div>
            <img class="hero-emblem" src="/images/logo-simbolo.webp" alt="" width="572" height="612" />
            <span class="spark spark-a"></span><span class="spark spark-b"></span><span class="spark spark-c"></span>
          </div>
        </div>
        <div class="hero-bottom-line" aria-hidden="true"></div>
      </section>

      <section class="intro-strip" aria-label="Áreas de SamiTecnologia">
        <div class="container intro-strip-content">
          <span class="strip-label">UN LUGAR PARA</span>
          <span>Aprender <b>•</b> Crear <b>•</b> Resolver <b>•</b> Innovar</span>
          <a href="#categorias">Conoce las áreas <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section categories-section" id="categorias" aria-labelledby="categorias-title">
        <div class="container">
          <div class="section-top">
            <div class="section-heading">
              <span class="overline"><span class="overline-mark"></span> TU PUNTO DE PARTIDA</span>
              <h2 id="categorias-title">Explora un mundo de <span>posibilidades.</span></h2>
              <p>Elige el tema que te interesa. Cada sección está pensada para aprender de forma clara y llevar tus conocimientos a la práctica.</p>
            </div>
            <span class="section-index" aria-hidden="true">01 / EXPLORAR</span>
          </div>
          <div class="category-grid">
            {categorias.map((categoria) => (
              <a class={`category-card category-${categoria.clase}`} href={categoria.destino} aria-label={`Explorar ${categoria.nombre}`}>
                <div class="category-top"><span class="category-icon" aria-hidden="true">{categoria.icono}</span><span class="category-number">{categoria.numero}</span></div>
                <div class="category-body"><span class="category-kicker">{categoria.etiqueta}</span><h3>{categoria.nombre}</h3><p>{categoria.descripcion}</p></div>
                <span class="category-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section editorial-section" id="contenidos" aria-labelledby="contenidos-title">
        <div class="container">
          <div class="section-top">
            <div class="section-heading">
              <span class="overline"><span class="overline-mark"></span> APRENDE A TU RITMO</span>
              <h2 id="contenidos-title">Conocimiento que <span>sí puedes aplicar.</span></h2>
              <p>Explora nuestras guías prácticas y aprende con ejemplos aplicables a tus proyectos.</p>
            </div>
            <span class="section-index" aria-hidden="true">02 / CONTENIDOS</span>
          </div>
          <div class="articles-grid">
            {proximosArticulos.map((articulo) => (
              <a class="article-card" href={articulo.enlace}>
                <div class={`article-cover article-cover-${articulo.tono}`} aria-hidden="true"><span class="article-cover-grid"></span><span class="article-cover-icon">{articulo.icono}</span><span class="article-cover-decoration"></span></div>
                <div class="article-copy"><div class="article-meta"><span>{articulo.categoria}</span><span class="coming-soon">{articulo.estado}</span></div><h3>{articulo.titulo}</h3><p>{articulo.descripcion}</p></div>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section tools-section" id="herramientas" aria-labelledby="herramientas-title">
        <div class="container tools-layout">
          <div class="tools-intro">
            <span class="overline"><span class="overline-mark"></span> SOLUCIONES A UN CLIC</span>
            <h2 id="herramientas-title">Herramientas útiles. <span>Sin complicaciones.</span></h2>
            <p>Queremos que encuentres aquí pequeñas soluciones que ahorren tiempo: desde cálculos de redes hasta utilidades para trabajar con datos y enlaces.</p>
            <div class="tools-note"><span class="note-dot"></span><span>Ya tienes seis herramientas gratuitas: calculadora IP, generador QR, conversor de bases, JSON, contraseñas y contador de palabras.</span></div>
          </div>
          <div class="tools-grid">
            {proximasHerramientas.map((herramienta) => (
              <a class="tool-card" href={herramienta.destino}>
                <span class={`tool-icon tool-icon-${herramienta.clase}`} aria-hidden="true">{herramienta.icono}</span>
                <h3>{herramienta.nombre}</h3>
                <p>{herramienta.descripcion}</p>
                <span class="tool-status">{herramienta.disponible ? 'Usar herramienta →' : 'Próximamente'}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="about-section" id="acerca" aria-labelledby="acerca-title">
        <div class="container about-layout">
          <div class="about-mark" aria-hidden="true"><img src="/images/logo-simbolo.webp" alt="" width="572" height="612" loading="lazy" /></div>
          <div class="about-copy"><span class="overline"><span class="overline-mark"></span> ESTO ES SAMITECNOLOGIA</span><h2 id="acerca-title">La curiosidad nos mueve. <span>La tecnología nos conecta.</span></h2><p>Creemos que aprender tecnología debe ser una experiencia clara, práctica e inspiradora. Por eso estamos construyendo un espacio donde las ideas encuentren herramientas para hacerse realidad.</p><a class="text-link" href="#categorias">Empieza a explorar <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-main">
        <div class="footer-identity"><a href="#inicio" aria-label="Volver al inicio"><img src="/images/logo-horizontal.webp" alt="SamiTecnologia" width="946" height="353" loading="lazy" /></a><p>Explora · Aprende · Innova</p></div>
        <nav aria-label="Enlaces del pie de página"><a href="#inicio">Inicio</a><a href="#categorias">Explorar</a><a href="#contenidos">Contenidos</a><a href="/herramientas/">Herramientas</a><a href="/nosotros/">Nosotros</a><a href="/contacto/">Contacto</a></nav>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} SamiTecnologia. Todos los derechos reservados.</span><span><a href="/privacidad/">Privacidad</a><a href="/cookies/">Cookies</a><a href="/terminos/">Términos</a></span></div>
    </footer>

    <dialog id="search-dialog" class="search-dialog" aria-label="Buscar en SamiTecnologia">
      <div class="search-panel">
        <div class="search-heading"><div><span class="overline">EXPLORA EL PORTAL</span><h2>¿Qué te gustaría encontrar?</h2></div><button type="button" class="close-search" data-close-search aria-label="Cerrar buscador">✕</button></div>
        <label class="search-field" for="search-input"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.7"/><path d="m16 16 4.5 4.5"/></svg><input id="search-input" type="search" autocomplete="off" placeholder="Buscar redes, programación, calculadora IP..." /></label>
        <p class="search-helper">Encuentra secciones y herramientas del portal.</p>
        <div class="search-results" id="search-results" aria-live="polite"></div>
      </div>
    </dialog>

    <script>
      import { indiceBusqueda } from '../data/search';
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');
      const searchDialog = document.querySelector<HTMLDialogElement>('#search-dialog');
      const searchInput = document.querySelector<HTMLInputElement>('#search-input');
      const searchResults = document.querySelector<HTMLElement>('#search-results');

      const closeMenu = () => {
        if (!menuButton || !mobileNavigation) return;
        menuButton.setAttribute('aria-expanded', 'false');
        menuButton.setAttribute('aria-label', 'Abrir menú');
        mobileNavigation.hidden = true;
      };

      menuButton?.addEventListener('click', () => {
        if (!mobileNavigation) return;
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        menuButton.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
        mobileNavigation.hidden = isOpen;
      });
      mobileNavigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.matchMedia('(min-width: 921px)').addEventListener('change', (event) => {
        if (event.matches) closeMenu();
      });

      const searchData = indiceBusqueda;

      const renderResults = (value: string) => {
        if (!searchResults) return;
        searchResults.replaceChildren();
        const normalized = value.trim().toLocaleLowerCase('es');
        const matches = searchData.filter((item) => `${item.name} ${item.description} ${item.tag}`.toLocaleLowerCase('es').includes(normalized));
        if (matches.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'search-empty';
          empty.textContent = 'No encontramos coincidencias. Prueba con otra palabra.';
          searchResults.append(empty);
          return;
        }
        matches.forEach((item) => {
          const link = document.createElement('a');
          link.href = item.href;
          link.className = 'search-result';
          const body = document.createElement('span');
          const title = document.createElement('strong');
          title.textContent = item.name;
          const description = document.createElement('small');
          description.textContent = item.description;
          const tag = document.createElement('span');
          tag.className = 'search-result-tag';
          tag.textContent = item.tag;
          body.append(title, description);
          link.append(body, tag);
          link.addEventListener('click', () => searchDialog?.close());
          searchResults.append(link);
        });
      };

      const openSearch = () => {
        if (!searchDialog || searchDialog.open) return;
        closeMenu();
        searchInput && (searchInput.value = '');
        renderResults('');
        searchDialog.showModal();
        searchInput?.focus();
      };
      document.querySelectorAll('[data-open-search]').forEach((button) => button.addEventListener('click', openSearch));
      document.querySelector('[data-close-search]')?.addEventListener('click', () => searchDialog?.close());
      searchInput?.addEventListener('input', () => renderResults(searchInput.value));
      searchDialog?.addEventListener('click', (event) => {
        if (event.target === searchDialog) searchDialog.close();
      });
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          if (searchDialog?.open) searchDialog.close();
          else openSearch();
        }
        if (event.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 95px; }
  :global(body) { margin: 0; background: #f5f8fc; color: #152a42; font-family: 'Inter', system-ui, -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { text-decoration: none; color: inherit; }
  :global(button), :global(input) { font: inherit; }
  :global(button) { cursor: pointer; }
  :global(img), :global(svg) { display: block; }
  :global(:focus-visible) { outline: 3px solid #49cfe9; outline-offset: 4px; }
  :global([hidden]) { display: none !important; }
  .container { width: min(1232px, calc(100% - 72px)); margin-inline: auto; }
  .skip-link { position: absolute; z-index: 1000; left: 12px; top: -80px; padding: 12px 18px; background: white; color: #09172b; border-radius: 8px; }
  .skip-link:focus { top: 12px; }

  /* Navegación */
  .site-header { position: relative; z-index: 20; background: #09172b; border-bottom: 1px solid rgba(153, 207, 241, .13); }
  .nav-shell { display: flex; align-items: center; justify-content: space-between; min-height: 96px; gap: 30px; }
  .brand { display: flex; align-items: center; width: 258px; flex-shrink: 0; }
  .brand img { width: 100%; height: 84px; object-fit: contain; object-position: left center; }
  .desktop-nav { display: flex; align-items: center; justify-content: center; gap: clamp(20px, 2.2vw, 35px); margin-left: auto; }
  .desktop-nav a { font-size: 13px; color: #b5c6d9; font-weight: 600; transition: color .2s ease; white-space: nowrap; }
  .desktop-nav a:hover, .desktop-nav .nav-active { color: #fff; }
  .desktop-nav .nav-active::after { content: ''; display: block; height: 2px; width: 18px; margin-top: 8px; background: #57daec; border-radius: 5px; }
  .header-actions { display: flex; align-items: center; gap: 10px; }
  .search-button { display: flex; align-items: center; gap: 10px; border: 1px solid #27445e; border-radius: 12px; background: #112841; color: #d9eaf7; padding: 10px 11px; font-size: 12px; font-weight: 600; transition: background .2s; }
  .search-button:hover { background: #1b3d59; }
  .search-button kbd { color: #8299af; border: 1px solid #33506a; border-radius: 5px; padding: 3px 4px; font-size: 10px; font-family: inherit; }
  .menu-button { display: none; align-items: center; justify-content: center; width: 43px; height: 43px; color: white; background: #132d46; border: 1px solid #2f4c68; border-radius: 10px; }
  .mobile-nav { background: #0d2137; border-top: 1px solid #213c56; padding: 9px 24px 20px; }
  .mobile-nav a { display: block; padding: 13px 6px; color: #e1effb; font-weight: 600; font-size: 14px; border-bottom: 1px solid #203950; }

  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; background: linear-gradient(125deg, #09172b 0%, #0b2038 55%, #0d3352 100%); color: white; }
  .hero-grid { position: absolute; inset: 0; opacity: .18; z-index: -1; background-image: linear-gradient(rgba(120, 189, 238, .12) 1px, transparent 1px),linear-gradient(90deg, rgba(120, 189, 238, .12) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(90deg, transparent 0%, black 65%); }
  .hero-orb { position: absolute; z-index: -1; border-radius: 50%; filter: blur(72px); pointer-events: none; }
  .hero-orb-one { width: 490px; height: 490px; background: rgba(16, 132, 211, .14); right: 5%; top: 4%; }
  .hero-orb-two { width: 240px; height: 240px; background: rgba(25, 224, 230, .09); left: 28%; bottom: -170px; }
  .hero-layout { min-height: 635px; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(340px, .8fr); gap: 45px; align-items: center; padding-top: 80px; padding-bottom: 95px; }
  .hero-copy { position: relative; z-index: 2; }
  .eyebrow { display: inline-flex; align-items: center; gap: 11px; color: #6de8f6; font-size: 11px; font-weight: 800; letter-spacing: .17em; margin-bottom: 26px; }
  .eyebrow-dot { width: 8px; height: 8px; border-radius: 50%; background: #53ebee; box-shadow: 0 0 0 6px rgba(83, 235, 238, .1); }
  h1,h2,h3,p { margin-top: 0; }
  h1,h2,h3 { font-family: 'Space Grotesk', 'Inter', sans-serif; }
  .hero h1 { font-size: clamp(48px, 5.1vw, 77px); font-weight: 700; letter-spacing: -.052em; line-height: 1.08; max-width: 770px; margin-bottom: 27px; }
  .hero h1 > span { display: block; color: #69e4f0; }
  .hero h1 .period { color: #fff; }
