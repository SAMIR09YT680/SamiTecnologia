---
import PortalLayout from '../layouts/PortalLayout.astro';
---
<PortalLayout
  title="Pagina no encontrada (404)"
  description="La pagina que buscas no existe o cambio de direccion. Explora SamiTecnologia y sus herramientas gratuitas."
>
  <section class="error-main">
    <div class="error-orb" aria-hidden="true"></div>
    <div class="error-wrap">
      <p class="error-kicker">HAY UNA RUTA NUEVA POR DESCUBRIR</p>
      <div class="error-code">404<span class="error-dot">.</span></div>
      <h1>Esta pagina <em>no esta aqui.</em></h1>
      <p class="error-copy">Es posible que el enlace haya cambiado. Puedes volver al inicio o ir directamente a nuestras herramientas.</p>
      <div class="error-links">
        <a class="error-primary" href="/">Volver al inicio <span aria-hidden="true">↗</span></a>
        <a class="error-secondary" href="/herramientas/">Explorar herramientas <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <img class="error-symbol" src="/images/logo-simbolo.webp" width="572" height="612" alt="" aria-hidden="true" loading="lazy" />
  </section>
</PortalLayout>
<style>
  .error-main { min-height: 68vh; position: relative; isolation: isolate; overflow: hidden; background: linear-gradient(120deg,#09172b,#0c304b); color: white; display:flex; align-items:center; justify-content:center; padding:96px 7%; }
  .error-orb { position:absolute; right:3%; width:480px; height:480px; border-radius:50%; background: #1d86d0; opacity:.18; filter:blur(100px); z-index:-1; }
  .error-wrap { position:relative; z-index:2; max-width:1040px; width:100%; }
  .error-kicker { font-size:12px; font-weight:800; color:#69e4f0; letter-spacing:.16em; }
  .error-code { font:700 clamp(110px,19vw,220px)/1 'Space Grotesk',sans-serif; letter-spacing:-.08em; color:#fff; margin:17px 0; }
  .error-dot { color:#67e5f5; }
  h1 { color:#fff; font:700 clamp(30px,4vw,50px)/1.15 'Space Grotesk',sans-serif; margin:0 0 20px; }
  h1 em { color:#67e5f5; font-style:normal; }
  .error-copy { max-width:540px; font-size:16px; line-height:1.8; color:#c7d8ea; }
  .error-links { display:flex; gap:14px; flex-wrap:wrap; margin-top:32px; }
  .error-links a { display:inline-flex; gap:14px; align-items:center; min-height:49px; padding:12px 20px; border-radius:11px; font-size:13px; font-weight:800; }
  .error-primary { background:linear-gradient(110deg,#75e9f1,#39b7ee); color:#061d2e; }
  .error-secondary { border:1px solid #4c718e; color:#fff; }
  .error-symbol { position:absolute; right:6%; width:min(34vw,330px); height:auto; z-index:0; opacity:.55; pointer-events:none; }
  @media(max-width:820px) { .error-symbol { right:-45px; width:250px; opacity:.14; } .error-main {padding:75px 6%;} }
  @media(prefers-reduced-motion:reduce) { .error-main { scroll-behavior:auto; } }
</style>
